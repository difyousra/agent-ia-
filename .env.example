OPENAI_API_KEY=sk-your-key
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat

VECTOR_BACKEND=chroma
CHROMA_PATH=./chroma_db
CHROMA_COLLECTION=contract_chunks

EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
EMBEDDING_BACKEND=auto
RERANKER_BACKEND=auto

RAG_SEMANTIC_TOP_K=10
RAG_KEYWORD_TOP_K=10
RAG_HYBRID_TOP_K=20
RAG_RERANK_TOP_N=5
RAG_RRF_K=60

# Intelligent routing
DEBUG_AGENT_ROUTING=false
ROUTER_BACKEND=rules

# External legal API (optional; only used when route needs legal info)
LEGAL_SEARCH_ENABLED=false
LEGAL_API_URL=
LEGAL_API_KEY=
LEGAL_API_TIMEOUT=20
DEFAULT_JURISDICTION=DZ
